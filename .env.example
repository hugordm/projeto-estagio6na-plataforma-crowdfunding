# Variáveis do docker-compose.yml (portas e URLs públicas). Copie para .env na raiz, se quiser mudar algo.
# Os segredos da aplicação NÃO ficam aqui: estão em backend/.env e frontend/.env.local.

# Portas no seu computador.
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Endereços que o NAVEGADOR usa. Se mudar as portas acima, ajuste também estas duas.
PUBLIC_BACKEND_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:3000

# UID do usuário do container do backend (Linux: o resultado de "id -u"), para gravar em backend/uploads.
APP_UID=1000

# Perfil "local-db" (Postgres + pgvector local). Descomente para o backend usar o banco local em vez do Neon:
# LOCAL_DATABASE_URL=postgresql://crowdfunding:crowdfunding@db:5432/crowdfunding
DB_PORT=5433

# Login HTTP Basic de /docs e /docs.json: defina no backend/.env (o compose repassa pelo env_file), não aqui.
# Se definidas aqui, o docker-compose NÃO as lê. Deixadas comentadas de propósito:
# DOCS_USER=
# DOCS_PASSWORD=

# Armazenamento das imagens: STORAGE_PROVIDER e as credenciais do Cloudinary também ficam no backend/.env
# (o compose repassa pelo env_file), pelo mesmo motivo. Com STORAGE_PROVIDER=cloudinary o volume de
# backend/uploads só serve as imagens antigas. Deixadas comentadas de propósito:
# STORAGE_PROVIDER=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=
# CLOUDINARY_FOLDER=
