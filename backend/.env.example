# Copie para .env e preencha. Nunca versione o .env.

# Banco PostgreSQL (Neon). Use a connection string com "-pooler" do painel do Neon.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Chave para assinar os tokens JWT. Gere uma longa e aleatória, ex.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Porta do servidor (padrão 3001)
PORT=3001

# Endereço público do backend, usado nas URLs das imagens enviadas (padrão http://localhost:PORT)
BACKEND_URL="http://localhost:3001"

# Endereço do frontend (padrão http://localhost:3000). Usado nos links dos e-mails e no CORS:
# só essas origens podem chamar a API pelo navegador. Mais de uma: separe por vírgula.
FRONTEND_URL="http://localhost:3000"

# Proxies confiáveis na frente da API (Render, Docker, Nginx...), para o rate limit ler o IP real do cliente.
# Vazio ou "false" (padrão): a API recebe as conexões direto. Atrás de um proxy: "1" (um salto).
# Também aceita "true" ou uma lista de IPs/sub-redes (ex.: "loopback, 10.0.0.0/8").
TRUST_PROXY=""

# Documentação da API em /docs (Swagger UI) e /docs.json. "false" desliga (ex.: em produção). Padrão: ligada.
DOCS_ENABLED="true"
# Opcional: com as duas definidas, /docs e /docs.json pedem login HTTP Basic (rate limit por IP). Vazias: abertas.
DOCS_USER=""
DOCS_PASSWORD=""

# Armazenamento das imagens (upload e capa por IA): local (padrão, pasta backend/uploads) | cloudinary.
# Em hospedagem com disco efêmero (Render, Heroku...), use cloudinary. URLs antigas /uploads/... continuam valendo.
STORAGE_PROVIDER="local"
# Cloudinary (painel > Settings > API Keys). Use as três abaixo OU só CLOUDINARY_URL (cloudinary://<key>:<secret>@<cloud>).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""
# Pasta das capas no Cloudinary (padrão crowdfunding/campaigns). Use outra para separar desenvolvimento e produção.
CLOUDINARY_FOLDER="crowdfunding/campaigns"

# E-mail (Resend). Sem estas duas, o link de recuperação de senha só aparece no console (fora de produção).
# Sem domínio verificado, use RESEND_FROM_EMAIL="Crowdfunding <onboarding@resend.dev>" (entrega só para o e-mail do dono da conta Resend).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Crowdfunding <nao-responda@seudominio.com>"

# Provedores de IA para texto e capa (valores aceitos abaixo). Embeddings/busca semântica usam sempre o OpenRouter.
# CHAT_PROVIDER: openrouter (padrão) | anthropic   -> chatbot e demais textos gerados por IA
CHAT_PROVIDER="openrouter"
# COVER_PROVIDER: openrouter (padrão, imagem PNG/JPEG/WebP) | anthropic-svg (ilustração vetorial gerada pelo Claude)
COVER_PROVIDER="openrouter"

# Anthropic (Claude). Necessária quando CHAT_PROVIDER=anthropic ou COVER_PROVIDER=anthropic-svg.
ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL="claude-haiku-5-5"
ANTHROPIC_COVER_MODEL="claude-sonnet-5-5"

# IA (OpenRouter). Sem a chave ou o modelo, o recurso correspondente fica indisponível (sem derrubar o servidor).
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="google/gemini-3.5-flash-lite"
# Atenção: a coluna do banco é vector(1024). Trocar o modelo de embeddings exige migration e backfill (veja o README).
OPENROUTER_EMBEDDING_MODEL="baai/bge-m3"
OPENROUTER_IMAGE_MODEL="recraft/recraft-v4.1-flash"
